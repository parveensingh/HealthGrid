# Django Backend Environment Configuration

# Django Secret Key (generate a strong secret key for production)
DJANGO_SECRET_KEY=local-demo-only-change-this-before-any-shared-deployment

# Debug mode (true / false)
DJANGO_DEBUG=true

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Blockchain configuration (Local Hardhat Node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_ACCOUNT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BLOCKCHAIN_DEPLOYMENT_FILE=../contracts/deployment.json

# Optional: IPFS Kubo HTTP API URL (leave blank to store encrypted files locally)
# Example: KUBO_API_URL=http://127.0.0.1:5001
KUBO_API_URL=
